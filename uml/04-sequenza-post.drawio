        <mxCell id="n1" value="&lt;b&gt;Senza express.json() niente funziona&lt;/b&gt;&#10;&#10;E' il middleware che legge il corpo della&#10;richiesta e lo trasforma in req.body.&#10;&#10;Se manca — o se il client non manda&#10;Content-Type: application/json —&#10;req.body resta undefined e la create fallisce." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="330" width="280" height="130" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;Validazione mancante&lt;/b&gt;&#10;&#10;Oggi req.body passa dritto a Prisma.&#10;&#10;body vuoto {}    → crea con campi null&#10;ruolo 'Capo'      → 500, dovrebbe essere 400&#10;&#10;Regola: 5xx = colpa del server&#10;              4xx = colpa del client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
