        <!-- ===== note ===== -->
        <mxCell id="n2" value="Perche' l'array vuoto []&#10;&#10;Significa: esegui UNA VOLTA sola.&#10;Senza, la fetch cambia lo stato,&#10;lo stato provoca un ridisegno,&#10;il ridisegno rilancia la fetch…&#10;→ ciclo infinito." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="230" height="115" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Perche' serve gestisciRisposta()&#10;&#10;fetch NON lancia errori sui codici HTTP.&#10;Un 404 o un 500 arrivano come risposte&#10;normali, con res.ok = false.&#10;&#10;Senza il controllo, un errore del server&#10;finirebbe nella tabella come un dato." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
