        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;Attenzione alle relazioni&lt;/b&gt;&#10;&#10;Se un dipendente fosse collegato ad altri&#10;record (ordini, presenze…), PostgreSQL&#10;puo' rifiutare la cancellazione per non&#10;lasciare riferimenti rotti.&#10;&#10;Prisma restituisce il codice P2003&#10;(foreign key constraint)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
