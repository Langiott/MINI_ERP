<mxfile host="app.diagrams.net">
  <diagram name="Prisma traduce" id="orm1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="1" />

        <mxCell id="t" value="Prisma: da oggetti a tabelle e ritorno" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="325" y="15" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="lo stesso dato, scritto in due lingue diverse" style="text;html=1;fontSize=12;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="375" y="42" width="400" height="20" as="geometry" />
        </mxCell>

        <mxCell id="colsx" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=none;opacity=25;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="330" height="640" as="geometry" />
        </mxCell>
        <mxCell id="colmid" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=none;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="410" y="80" width="330" height="640" as="geometry" />
        </mxCell>
        <mxCell id="coldx" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=none;opacity=25;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="330" height="640" as="geometry" />
        </mxCell>

        <mxCell id="hsx" value="MONDO JAVASCRIPT&#10;si ragiona per oggetti" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="250" height="48" as="geometry" />
        </mxCell>
        <mxCell id="hmid" value="PRISMA&#10;il traduttore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="250" height="48" as="geometry" />
        </mxCell>
        <mxCell id="hdx" value="MONDO POSTGRESQL&#10;si ragiona per righe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="250" height="48" as="geometry" />
        </mxCell>

        <mxCell id="andata" value="ANDATA — la domanda" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#4d7a33;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="260" height="20" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="① scrivi questo nel controller&#10;&#10;const dip = await prisma.dipendenti&#10;  .findMany()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="290" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="350" y="255" as="sourcePoint" /><mxPoint x="450" y="255" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="c2" value="② Prisma traduce&#10;&#10;legge lo schema.prisma,&#10;sa che il model Dipendenti&#10;è la tabella &quot;Dipendenti&quot;&#10;e scrive l'SQL corrispondente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="200" width="290" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="720" y="255" as="sourcePoint" /><mxPoint x="820" y="255" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="c3" value="③ al database arriva questo&#10;&#10;SELECT id, nome, cognome,&#10;       ruolo, repartoId&#10;FROM &quot;Dipendenti&quot;;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="800" y="210" width="290" height="100" as="geometry" />
        </mxCell>

        <mxCell id="sep" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="60" y="345" as="sourcePoint" /><mxPoint x="1090" y="345" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="ritorno" value="RITORNO — la risposta" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#9c2b28;align=right;" vertex="1" parent="1">
          <mxGeometry x="830" y="360" width="260" height="20" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="④ il database restituisce righe&#10;&#10; id | nome   | cognome   | repartoId&#10;----+--------+-----------+----------&#10;  4 | Andrea | Langiotti |     2&#10;  5 | Mario  | Rossi     |     2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="800" y="390" width="290" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e3" style="endArrow=open;dashed=1;html=1;strokeColor=#d79b00;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="800" y="445" as="sourcePoint" /><mxPoint x="720" y="445" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="c5" value="⑤ Prisma ritraduce&#10;&#10;ogni riga diventa un oggetto,&#10;i tipi SQL diventano tipi JS:&#10;integer → number&#10;text → string&#10;NULL → null" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="385" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e4" style="endArrow=open;dashed=1;html=1;strokeColor=#d79b00;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="430" y="445" as="sourcePoint" /><mxPoint x="350" y="445" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="c6" value="⑥ nel codice torna questo&#10;&#10;[ { id: 4, nome: 'Andrea',&#10;    cognome: 'Langiotti',&#10;    repartoId: 2 },&#10;  { id: 5, nome: 'Mario', … } ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="290" height="115" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="&lt;b&gt;Perché serve un traduttore&lt;/b&gt;&#10;&#10;Le due lingue non coincidono. Una tabella è una griglia piatta di righe e colonne; un oggetto JavaScript può contenere altri oggetti dentro di sé.&#10;&#10;Quando chiedi un dipendente con il suo reparto, Prisma riceve dal database una riga piatta e costruisce un oggetto annidato: reparto diventa un oggetto dentro il dipendente. Questa differenza di forma è il motivo per cui un ORM esiste." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="545" width="480" height="160" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;Cosa NON fa Prisma&lt;/b&gt;&#10;&#10;Non conserva i dati: quelli stanno solo in PostgreSQL. Se il container è spento, Prisma non ha nulla da cui leggere.&#10;&#10;Non è nemmeno indispensabile: si potrebbe scrivere l'SQL a mano. Prisma evita di doverlo fare, e controlla i tipi mentre scrivi." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="545" width="510" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
