        </mxCell>

        <mxCell id="bivio" value="⑩ if (result.count === 0) → 404&#10;altrimenti → 200 { eliminati: 2 }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="710" width="250" height="45" as="geometry" />
        </mxCell>

        <mxCell id="r3" style="endArrow=open;dashed=1;html=1;strokeColor=#d79b00;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="675" y="785" as="sourcePoint" /><mxPoint x="310" y="785" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="r3t" value="⑪ 200 { eliminati: 2 }  ·  400  ·  404" style="text;html=1;fontSize=11;align=center;fontColor=#a06800;" vertex="1" parent="1">
          <mxGeometry x="320" y="763" width="350" height="18" as="geometry" />
        </mxCell>

        <mxCell id="r4" style="endArrow=open;dashed=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="310" y="815" as="sourcePoint" /><mxPoint x="125" y="815" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="r4t" value="⑫ ricarica la lista&#10;e svuota le checkbox" style="text;html=1;fontSize=11;align=center;fontColor=#4d7a33;" vertex="1" parent="1">
          <mxGeometry x="80" y="778" width="230" height="32" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="&lt;b&gt;Perche' deleteMany e non un ciclo&lt;/b&gt;&#10;&#10;Un ciclo di delete farebbe N viaggi al DB.&#10;E se il terzo id non esiste, delete lancia&#10;P2025: il ciclo si interrompe, i primi due&#10;sono gia' cancellati, gli altri no.&#10;&#10;→ resti a meta', senza saperlo.&#10;&#10;deleteMany fa tutto in una query sola." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="45" y="330" width="285" height="155" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;deleteMany NON lancia P2025&lt;/b&gt;&#10;&#10;Se non trova nulla restituisce { count: 0 }.&#10;Per questo il 404 si controlla con un if,&#10;non nel catch — al contrario di delete.&#10;&#10;E restituisce solo il conteggio: i record&#10;cancellati non tornano indietro." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="45" y="505" width="285" height="135" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="&lt;b&gt;Nota pratica&lt;/b&gt;&#10;&#10;Alcuni client HTTP non inviano il body&#10;con DELETE. Se req.body arriva vuoto,&#10;sposta questo endpoint su&#10;POST /api/dipendenti/elimina-multipli." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="45" y="660" width="285" height="110" as="geometry" />
        </mxCell>

