        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;findUnique restituisce null&lt;/b&gt;&#10;&#10;Non lancia eccezioni se non trova.&#10;Per questo il 404 si controlla con un if,&#10;NON nel catch.&#10;&#10;update e delete invece lanciano P2025:&#10;li' il 404 va nel catch." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
